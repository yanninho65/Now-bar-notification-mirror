<resources>
    <style name="Theme.NowBarMirror" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/one_ui_primary</item>
        <item name="colorPrimaryDark">@color/one_ui_primary</item>
        <item name="colorAccent">@color/one_ui_primary</item>
        <item name="colorOnPrimary">@color/one_ui_on_primary</item>
        <item name="colorSurface">@color/one_ui_surface</item>
        <item name="android:colorBackground">@color/one_ui_background</item>
        <item name="android:windowBackground">@color/one_ui_background</item>
        <item name="android:textColorPrimary">@color/one_ui_text_primary</item>
        <item name="android:textColorSecondary">@color/one_ui_text_secondary</item>
    </style>

    <!-- Entrées de menu en carte (écran principal, Autorisations) — 24/09/2026. -->
    <style name="MainMenuButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/one_ui_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MainMenuDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/one_ui_divider</item>
    </style>

    <!-- Petite ligne d'état sous une entrée de la carte Autorisations. -->
    <style name="MenuStatusText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginTop">-8dp</item>
        <item name="android:textColor">@color/one_ui_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!--
        NEW 18/09/2026 — PeekOpenTrampolineActivity's theme (see its class doc). Fully transparent
        and animation-less so this activity is never actually visible: it exists only to relay a
        widget tap into a real target after closing the peek, and finishes itself immediately.
    -->
    <style name="Theme.NowBarMirror.Trampoline" parent="Theme.NowBarMirror">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
