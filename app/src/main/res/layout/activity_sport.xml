<?xml version="1.0" encoding="utf-8"?>
<!-- Sport (24/09/2026, ex-onglet de l'écran principal) — voir sport/SportActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/one_ui_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sport_title"
        android:textColor="@color/one_ui_text_primary"
        android:textStyle="bold"
        android:textSize="26sp"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/sport_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/one_ui_text_secondary"
        android:textSize="14sp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sport_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="4dp" />

</LinearLayout>
