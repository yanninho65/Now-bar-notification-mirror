<?xml version="1.0" encoding="utf-8"?>
<!--
    4x1 widget, no background by design (Yann wants it to sit directly over the lock screen
    wallpaper via LockStar, not on a card).

    RESTRUCTURED to add the Sofascore "Sport" view (widget_sofascore_content below): the root is
    now a horizontal row — a persistent LEFT COLUMN (widget_app_icon + widget_view_toggle) that
    stays in the same place across both views, next to a CONTENT AREA (widget_content_area, a
    FrameLayout) that shows exactly one of two overlapping blocks at a time, switched by
    NowBarWidgetProvider.buildViewsUnsafe() based on WidgetViewModePrefs:
    - widget_latest_content: the ORIGINAL single-notification view — unchanged below except that
      widget_app_icon moved out into the shared left column, and the "tap to open" click target
      moved from the old whole-widget root onto this block specifically (see
      NowBarWidgetProvider.applyLatestContent). A widget instance with no Sofascore data at all
      still renders pixel-identical to before this change (toggle hidden, only this block shown).
    - widget_sofascore_content: NEW — up to 4 Sofascore matches side by side (widget_match_1..4,
      a fixed-slot pattern like widget_action_1..3 above), or widget_sofascore_empty if there's
      currently nothing to show.

    widget_view_toggle (the small rotating-arrows button under the icon) switches between the two
    — see NowBarWidgetProvider.applyViewToggle / onReceive(ACTION_TOGGLE_VIEW). It only shows in
    the latest-notif view once there's at least one Sofascore match to switch to; it always shows
    in the Sofascore view so Yann can always get back.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!--
        Left column, shared by both views — widget_app_icon shows the mirrored app's icon in the
        latest-notif view, or Sofascore's own icon in the Sofascore view (see
        NowBarWidgetProvider.applyLatestContent / applySofascoreIcon). widget_view_toggle sits
        right under it, GONE by default (same default-gone convention as widget_actions_container
        below), so nothing changes visually until there's actually a Sofascore match to switch to.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_view_toggle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="3dp"
            android:padding="3dp"
            android:background="@drawable/widget_dismiss_background"
            android:src="@drawable/ic_widget_switch_view"
            android:contentDescription="@null"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_content_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp">

        <!-- ORIGINAL single-notification view — unchanged below except widget_app_icon moving out above. -->
        <LinearLayout
            android:id="@+id/widget_latest_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/widget_right_cluster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/widget_image"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="10dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/widget_dismiss"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:padding="4dp"
                        android:background="@drawable/widget_dismiss_background"
                        android:src="@drawable/ic_widget_dismiss"
                        android:contentDescription="@null" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/widget_right_cluster"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="Titre de la notification" />

                    <TextView
                        android:id="@+id/widget_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:text="Aperçu du texte de la notification, qui peut être un peu plus long que le titre." />
                </LinearLayout>

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/widget_actions_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_action_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_action_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_action_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!--
            NEW — Sofascore "Sport" view. Up to 4 fixed match slots (same fixed-slot pattern as
            widget_action_1..3 above, rather than a RemoteViews collection, since the cap is a
            small fixed number) — see NowBarWidgetProvider.applySofascoreMatches. Each slot is a
            small vertical card: combined team image on top (Sofascore's own notification image —
            NOT cropped to a circle like widget_image above, since it's usually two logos side by
            side and a circular crop would cut one of them off), score (bracket around whichever
            side just scored, same convention as the Sofascore notification itself) in the middle,
            period/status at the bottom. Same top-to-bottom order as the watch's SMALL_IMAGE
            complication (wear/ComplicationImageComposer.kt), reworked to compact phone
            proportions rather than copying its pixel sizes (tuned for a 320px circular bitmap).
        -->
        <LinearLayout
            android:id="@+id/widget_sofascore_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/widget_match_1"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_match_1_image"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxWidth="52dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_match_1_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_match_1_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_match_2"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_match_2_image"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxWidth="52dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_match_2_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_match_2_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_match_3"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_match_3_image"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxWidth="52dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_match_3_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_match_3_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_match_4"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_match_4_image"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxWidth="52dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_match_4_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_match_4_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <TextView
                android:id="@+id/widget_sofascore_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sofascore_widget_empty"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
