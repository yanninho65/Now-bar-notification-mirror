<?xml version="1.0" encoding="utf-8"?>
<!--
    4x1 widget, no background by design (Yann wants it to sit directly over the lock screen
    wallpaper via LockStar, not on a card). Two rows: the usual single line (app icon, title+text,
    notification image, dismiss button), and — only when "Actions dans le widget" is on and the
    current notification has live action PendingIntents — a second row underneath with up to
    three small text buttons (the action's own label, e.g. "Répondre"), indented to sit under
    the title/text rather than under the app icon.

    The actions row defaults to gone in the XML itself, so an instance where the setting is off
    (or hasn't been rebuilt since it was added) renders pixel-identical to before this option
    existed. Root is a vertical LinearLayout with gravity=center_vertical so the whole block —
    one row or two — stays vertically centered in whatever height the widget is placed at.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/widget_right_cluster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_dismiss"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:padding="4dp"
                android:background="@drawable/widget_dismiss_background"
                android:src="@drawable/ic_widget_dismiss"
                android:contentDescription="@null" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/widget_right_cluster"
            android:layout_toEndOf="@id/widget_app_icon"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Titre de la notification" />

            <TextView
                android:id="@+id/widget_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:text="Aperçu du texte de la notification, qui peut être un peu plus long que le titre." />
        </LinearLayout>

    </RelativeLayout>

    <!--
        Indented by 42dp = 32dp app-icon width + 10dp margin, so this row starts directly under
        the title/text above instead of under the app icon.
    -->
    <LinearLayout
        android:id="@+id/widget_actions_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="42dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_action_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_action_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_action_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
