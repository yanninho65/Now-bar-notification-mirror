                    <ImageView android:id="@+id/widget_dismiss"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:padding="4dp"
                        android:background="@drawable/widget_dismiss_background"
                        android:src="@drawable/ic_widget_dismiss"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/widget_right_cluster"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical">

                    <TextView android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="Titre de la notification" />

                    <TextView android:id="@+id/widget_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:text="Aperçu du texte de la notification, qui peut être un peu plus long que le titre." />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout android:id="@+id/widget_actions_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView android:id="@+id/widget_action_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView android:id="@+id/widget_action_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView android:id="@+id/widget_action_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
