<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Vignette optionnelle : l'image que extractNotificationImage
         enverrait à la montre pour ce match — absente pour "Dernière
         notification" (voir SofascoreHomeAdapter). -->
    <ImageView
        android:id="@+id/itemImage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/itemText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp" />

    <!-- Ouvre l'écran de choix d'API (TheSportsDB/Live Tennis) pour CETTE
         notification précise — voir MainActivity.openApiPickerFor().
         Masqué pour "Dernière notification" (pas une notif précise à
         laquelle associer un override). Le texte du bouton ("API" ou
         "API ✓") reflète si un override est déjà configuré. -->
    <Button
        android:id="@+id/itemApiButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="API"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
