<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
        NEW 22/09/2026 — "Aff. sur tél." (montre) ouvre maintenant sa notification relais en
        plein écran (voir NowBarWidgetProvider.openEntry) plutôt que comme une notification à
        taper manuellement. Sur Android 14+ (targetSdk 34+, notre cas), cette permission n'est
        PAS auto-accordée pour une app qui n'est ni téléphonie ni alarme (écran Autorisations,
        PermissionsActivity) — et l'installateur peut la réinitialiser à chaque mise à jour. Depuis
        le 24/09/2026 l'association de la montre (WatchCompanionLink) prend le relais ; le plein
        écran reste utilisé téléphone verrouillé s'il est accordé.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Association montre (CompanionDeviceManager, WatchCompanionLink) — facultatif. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!--
        Package visibility (Android 11+, applies to any app targeting API 30+): without this,
        getInstalledApplications() / getLaunchIntentForPackage() only see this app itself and
        system apps — every normal user-installed app (WhatsApp, Signal, etc.) is invisible.
        This declares "let me see any app that has a launcher icon", which matches exactly what
        AppSelectionActivity filters on. The Sofascore package query is for SofascoreNotificationListenerService
        (com.sofascore.results, verified via its Play Store listing — not to be confused with
        "Livesport"/Soccerway, a different publisher).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.sofascore.results" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.NowBarMirror">

        <!-- Samsung/One UI ongoing-activity hint. Harmless on other Android builds. -->
        <meta-data
            android:name="com.samsung.android.support.ongoing_activity"
            android:value="true" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.AppSelectionActivity"
            android:label="@string/app_selection_title"
            android:exported="false" />

        <!-- NEW 24/09/2026 : écrans ouverts depuis l'écran principal (ex-onglet Sport, options, autorisations). -->
        <activity
            android:name=".sport.SportActivity"
            android:label="@string/sport_title"
            android:exported="false" />

        <activity
            android:name=".settings.SettingsActivity"
            android:label="@string/settings_title"
            android:exported="false" />

        <activity
            android:name=".settings.PermissionsActivity"
            android:label="@string/permissions_title"
            android:exported="false" />

        <!-- NEW 24/09/2026 : choix des applis de messagerie (complication montre "Messages"). -->
        <activity
            android:name=".settings.MessageAppsActivity"
            android:label="@string/message_apps_title"
            android:exported="false" />

        <!--
            PeekOpenTrampolineActivity and OpenPeekTrampolineActivity (18/09 and 20/09/2026) were
            REMOVED 20/09/2026 — see NowBarWidgetProvider's class doc, "REWORKED 20/09/2026"
            section: any Activity a lock-screen widget host launches interacts with the keyguard
            one way or another, whatever that Activity's own code asks for, which is what kept
            causing new lock-screen regressions each time one of these was introduced or changed.
            Opening a peek (a tile's tap) is a plain broadcast again (ACTION_OPEN_PEEK), and the
            peek's own content tap is a direct PendingIntent to the real target again — neither
            needs an Activity of its own any more, so Theme.NowBarMirror.Trampoline is unused too
            (kept in styles.xml in case a future fix needs an invisible Activity again).
        -->

        <service
            android:name=".MirrorNotificationListener"
            android:label="@string/service_name"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!--
                Must include "ongoing" and "silent": our own mirror notification is both
                (setOngoing(true) + an IMPORTANCE_LOW channel), so without these the system
                never delivers onNotificationRemoved for the mirror itself, and the
                mirror -> original delete sync silently never fires.
            -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="ongoing|conversations|alerting|silent" />
        </service>

        <!--
            Onglet Sport (voir README.md, section "Fusion avec Sport Watch Complication") — un
            NotificationListenerService DISTINCT de MirrorNotificationListener ci-dessus, avec sa
            propre bascule dans Paramètres > Notifications > Accès aux notifications : Yann doit
            l'activer séparément, en plus de celle de MirrorNotificationListener. exported=true et
            la permission BIND_NOTIFICATION_LISTENER_SERVICE sont IMPOSÉS par Android pour ce type
            de service (c'est le système, pas une autre app, qui s'y lie).
        -->
        <service
            android:name=".sport.SofascoreNotificationListenerService"
            android:label="@string/sport_service_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            FIX (17/09/2026, Yann: "je ne vois que celles apparues après la mise à jour") — see
            PackageUpdateReceiver's class doc for the full reasoning. exported="false" is enough:
            ACTION_MY_PACKAGE_REPLACED is a protected system broadcast the OS sends only to this
            app itself, right after it's updated — nothing else can trigger it.
        -->
        <receiver
            android:name=".PackageUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            NEW 21/09/2026 — reçoit depuis la montre les demandes d'action/suppression envoyées par
            l'écran de détail de la complication "Notification" (voir WearActionRelayService.kt et
            wear/NotificationDetailActivity.kt). exported="true" imposé par Android pour tout
            WearableListenerService : c'est Google Play Services (processus externe), pas cette app
            elle-même, qui s'y lie pour relayer le message reçu de la montre.
        -->
        <service
            android:name=".WearActionRelayService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/notifdetail" />
                <!-- NEW 24/09/2026 : liste "Messages" de la montre -->
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/msgdetail" />
            </intent-filter>
        </service>

        <!--
            exported="false" is enough: android.appwidget.action.APPWIDGET_UPDATE is a protected
            system broadcast, so only the OS can send it regardless of this flag — that's also
            what lets a lock-screen widget host like Samsung's LockStar bind and refresh this
            widget through the normal AppWidgetHost APIs.
        -->
        <receiver
            android:name=".widget.NowBarWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_bar_widget_info" />
        </receiver>

        <!--
            NEW 22/09/2026 — deuxième widget, 4x2 (voir NowBarWidgetProviderCompact/
            widget_now_bar_compact.xml's class docs) : icônes sport/toutes notifs en haut,
            "Dernière notif"/peek en bas, harmonisé au maximum avec le widget ci-dessus (même
            exported="false" reasoning : android.appwidget.action.APPWIDGET_UPDATE est un broadcast
            système protégé).
        -->
        <receiver
            android:name=".widget.NowBarWidgetProviderCompact"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_bar_widget_compact_info" />
        </receiver>

        <!--
            NEW 23/09/2026 — troisième widget (voir NowBarWidgetProviderTriple/widget_now_bar_triple.xml's
            class docs) : deux lignes d'icônes permanentes (dernière notif générique, puis
            Sofascore) plus la vue texte toujours en bas. Même exported="false" reasoning que les
            deux widgets ci-dessus.
        -->
        <receiver
            android:name=".widget.NowBarWidgetProviderTriple"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_bar_widget_triple_info" />
        </receiver>
    </application>
</manifest>

