<?xml version="1.0" encoding="utf-8"?>
<!-- NEW 21/09/2026, écran de détail : bouton d'action de la notification (pilule arrondie, style
     bouton Galaxy Watch). UPDATED 22/09/2026 : rayon agrandi (18dp -> 26dp) pour rester une vraie
     pilule (bouts semi-circulaires) maintenant que le bouton est pleine largeur/plus haut (~52dp)
     au lieu d'un petit chip côte à côte — voir NotificationDetailActivity.actionChip.

     UPDATED 22/09/2026 x2 (Yann : "il manque une animation pour montrer que j'ai appuyé [...] le
     bouton [...] devient un peu blanc pour le signaler") : simple <shape> avant, sans state list,
     donc sans aucun retour visuel au toucher — devient un <selector> avec un état `state_pressed`
     plus clair (detail_chip_bg_pressed). Le rétrécissement (scale) qui accompagne ce changement de
     fond est géré séparément, en code, par NotificationDetailActivity.addPressFeedback. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/detail_chip_bg_pressed" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/detail_chip_bg" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
