<?xml version="1.0" encoding="utf-8"?>
<!-- Icône de la complication "Score en direct" dans le sélecteur (24/09/2026) : le terrain du widget
     téléphone (app/res/drawable/ic_football_pitch.xml), même dessin que l'état vide de la
     complication (ComplicationImageComposer.drawPitch). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Outer touchline/byline border. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M3,2 H21 V22 H3 Z" />
    <!-- Halfway line. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M3,12 H21" />
    <!-- Center circle. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:fillColor="#00000000"
        android:pathData="M15.2,12 A3.2,3.2 0 1,1 8.8,12 A3.2,3.2 0 1,1 15.2,12" />
    <!-- Top penalty area (goal line = outer border's top edge, so only the other three sides are drawn). -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M7,2 V7 H17 V2" />
    <!-- Bottom penalty area, mirrored. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M7,22 V17 H17 V22" />
</vector>
