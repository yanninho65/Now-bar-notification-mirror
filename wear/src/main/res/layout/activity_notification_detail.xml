<?xml version="1.0" encoding="utf-8"?>
<!--
    NEW 21/09/2026 — écran plein écran ouvert par un tap sur la complication "Notification" (voir
    NotificationDetailActivity.kt), style Galaxy Watch (fond noir, coins arrondis, gros pictogramme
    en haut, boutons ronds/en pilule) : Yann, "ça ouvre une fenêtre avec en haut l'image et logo de
    la notif, la notification en grand pour lire le texte en entier et les boutons d'actions [...]
    et la possibilité de supprimer la notif. Adopter le style galaxy watch."

    SwipeDismissFrameLayout = geste standard Wear OS/Galaxy Watch pour fermer un écran (balayage
    depuis le bord gauche) — voir NotificationDetailActivity.onCreate. Le contenu est dans un
    ScrollView classique plutôt qu'un BoxInsetLayout : une marge horizontale généreuse fixe
    (detail_side_padding) suffit à rester dans la zone "sûre" d'un écran rond sans dépendre d'une
    disposition plus complexe à mettre au point sans pouvoir compiler/tester localement (voir
    README, section Build).
-->
<androidx.wear.widget.SwipeDismissFrameLayout
    android:id="@+id/swipe_layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/detail_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <!-- En-tête, UPDATED 22/09/2026 x2 (Yann, 1ère passe : "Mettre image notif et icone
                 appli en haut sur même ligne [...] taille des deux un peu plus grande" ; 2e passe :
                 "Les icônes et image devraient être à côté et au centre au lieu d'être chacune
                 d'un côté") : image de la notif et icône de l'app côte à côte, collées l'une à
                 l'autre, le groupe centré sur la ligne — PAS un View à poids qui les écarte vers
                 les deux bords comme avant. Chacune ne montre toujours que SA propre chose (pas de
                 repli de l'une sur l'autre). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/detail_image"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/detail_app_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/detail_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/detail_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Titre — UPDATED 22/09/2026 (Yann : "Grossis les polices [...] taille système [...]
                 toujours le cas") : plus de taille codée en dur, android:textAppearance reprend
                 police ET taille du thème système (?android:attr/textAppearanceLarge) — inconditionnel,
                 pas une option. textColor/gravity/gras restent explicites par-dessus. -->
            <TextView
                android:id="@+id/detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textColor="@color/detail_text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Texte complet (notification simple, sans historique) — même principe que le titre
                 juste au-dessus, avec ?android:attr/textAppearanceMedium (un cran en dessous). -->
            <TextView
                android:id="@+id/detail_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/detail_text_primary"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Historique (messages de la conversation / événements du match) -->
            <LinearLayout
                android:id="@+id/detail_lines_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Boutons d'action de la notification, UPDATED 22/09/2026 : pilules pleine largeur
                 empilées verticalement (style menu de notification Galaxy Watch natif), au lieu de
                 chips côte à côte — voir NotificationDetailActivity.actionChip. Contient toujours
                 les actions propres de la notification puis la pilule "Aff. sur tél." (jamais
                 "Bloquer notifications", volontairement absente ici). -->
            <LinearLayout
                android:id="@+id/detail_actions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="18dp" />

            <!-- Suppression — UPDATED 22/09/2026 : agrandi (48dp -> 56dp) pour matcher la taille
                 du rond de suppression du vrai menu de notification Galaxy Watch (capture à
                 l'appui, Yann) ; couleurs désormais grises neutres (voir colors.xml). -->
            <ImageButton
                android:id="@+id/detail_delete_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_delete_button"
                android:src="@drawable/ic_delete"
                android:padding="14dp"
                android:contentDescription="@string/action_delete" />

        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.SwipeDismissFrameLayout>
