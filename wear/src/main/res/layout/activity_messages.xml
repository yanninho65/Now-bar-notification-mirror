<?xml version="1.0" encoding="utf-8"?>
<!-- NEW 24/09/2026 — liste "Messages" (voir MessagesActivity.kt) : même cadre que
     activity_notification_detail.xml (fond noir, balayage pour fermer, marges écran rond), un
     bloc item_message.xml par message, les uns après les autres. Marges : valeurs par défaut,
     remplacées en code par des fractions de l'écran rond (MessagesActivity.applyRoundInsets). -->
<androidx.wear.widget.SwipeDismissFrameLayout
    android:id="@+id/swipe_layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/detail_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/messages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp" />
    </ScrollView>
</androidx.wear.widget.SwipeDismissFrameLayout>
