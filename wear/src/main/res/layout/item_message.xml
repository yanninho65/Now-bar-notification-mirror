<?xml version="1.0" encoding="utf-8"?>
<!-- NEW 24/09/2026 — un message de la liste "Messages" : reprend exactement le contenu de
     activity_notification_detail.xml (en-tête image + icône, titre Large gras, texte/historique
     Medium, pilules d'action, rond de suppression), suivi d'un séparateur. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/message_image"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/message_app_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:visibility="gone"
            android:contentDescription="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/message_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="@color/detail_text_primary"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/message_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="@color/detail_text_primary"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/message_lines_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/message_actions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="18dp" />

    <ImageButton
        android:id="@+id/message_delete_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_delete_button"
        android:src="@drawable/ic_delete"
        android:padding="14dp"
        android:contentDescription="@string/action_delete" />

    <View
        android:id="@+id/message_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:background="@color/detail_chip_bg" />
</LinearLayout>
