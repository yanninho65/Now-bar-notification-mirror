<?xml version="1.0" encoding="utf-8"?>
<!-- NEW 25/09/2026 — une notification Sofascore de l'écran "Sport" (SportActivity.kt), entourée
     d'une pilule façon One UI Watch (bg_notif_pill) :
     - gauche : l'image de la complication "Score en direct" (logos, score, période —
       ComplicationImageComposer.composeRoundImage) et, dessous, la punaise "suivre ce match" ;
     - centre : le titre de la notification ;
     - droite : "Aff. sur tél." (ouvre sans supprimer) et supprimer, empilés. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sport_pill"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_notif_pill"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/sport_match_image"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/sport_follow_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_delete_button"
            android:src="@drawable/ic_pin"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:contentDescription="@string/sport_follow" />
    </LinearLayout>

    <TextView
        android:id="@+id/sport_match_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/detail_text_primary"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="4"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageButton
            android:id="@+id/sport_open_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_delete_button"
            android:src="@drawable/ic_phone"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:contentDescription="@string/action_view_on_phone" />

        <ImageButton
            android:id="@+id/sport_delete_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_delete_button"
            android:src="@drawable/ic_delete"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:contentDescription="@string/action_delete" />
    </LinearLayout>
</LinearLayout>
