<?xml version="1.0" encoding="utf-8"?>
<!-- NEW 25/09/2026, REWORKED twice the same day (Yann) — une notification Sofascore de l'écran
     "Sport" (SportActivity.kt), dans une pilule façon One UI Watch presque pleine largeur, compacte
     pour qu'un match à 4 buteurs tienne sur l'écran :
     - en haut : petite image de la notif puis le titre à sa droite ;
     - le score (crochets = côté qui vient de marquer), en grand, collé au titre ;
     - juste dessous, la période (toujours ici, pas en gras) ;
     - les buteurs (foot), minute décroissante, un par ligne, sur toute la largeur ;
     - en bas : punaise "suivre", "Aff. sur tél.", supprimer. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sport_pill"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_notif_pill"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/sport_match_image"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:maxWidth="48dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/sport_match_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/detail_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/sport_score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/detail_text_primary"
        android:textSize="34sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/sport_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sport_goals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/sport_follow_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_delete_button"
            android:src="@drawable/ic_pin"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:contentDescription="@string/sport_follow" />

        <ImageButton
            android:id="@+id/sport_open_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_delete_button"
            android:src="@drawable/ic_phone"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:contentDescription="@string/action_view_on_phone" />

        <ImageButton
            android:id="@+id/sport_delete_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_delete_button"
            android:src="@drawable/ic_delete"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:contentDescription="@string/action_delete" />
    </LinearLayout>
</LinearLayout>
