<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <queries>
        <package android:name="com.sofascore.results" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- NEW 21/09/2026 : écran de détail ouvert par un tap sur la complication "Notification"
             (voir NotificationComplicationService.notificationDetailTapAction et
             NotificationDetailActivity.kt). exported="true" : lancée depuis un PendingIntent tenu
             par le système/le cadran (processus externe), pas par cette app elle-même. Thème noir
             plein écran, sans barre de titre (style Galaxy Watch). -->
        <activity
            android:name=".NotificationDetailActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <service
            android:name=".ScoreComplicationService"
            android:exported="true"
            android:label="Score en direct"
            android:icon="@drawable/ic_notification"
            android:permission="com.google.android.wearable.permissions.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT,SMALL_IMAGE" />
            
            <!-- AUDIT 23/09/2026 : 600 s au lieu de 60 s. Les mises à jour sont poussées par le
                 téléphone (PhoneDataListenerService -> requestUpdateAll) ; le rappel périodique
                 ne sert que de filet de sécurité, et à 60 s il réveillait la montre chaque minute,
                 jour et nuit, pour relire l'item Data Layer et recomposer l'image. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="600" />
        </service>

        <!-- AUDIT 23/09/2026 : un seul WearableListenerService pour les deux chemins poussés par le
             téléphone ("/match" et "/notification"), fusion de MatchListenerService et
             NotificationDataListenerService — voir PhoneDataListenerService.kt. -->
        <service
            android:name=".PhoneDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/match" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/notification" />
            </intent-filter>
        </service>

        <!-- Complication "Notification" (20/09/2026) : dernière notification reçue, toutes
             apps mirorées confondues — distincte de "Score en direct" ci-dessus, SMALL_IMAGE
             uniquement (voir NotificationComplicationService.kt). -->
        <service
            android:name=".NotificationComplicationService"
            android:exported="true"
            android:label="Notification"
            android:icon="@drawable/ic_notification"
            android:permission="com.google.android.wearable.permissions.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE" />

            <!-- AUDIT 23/09/2026 : 600 s au lieu de 60 s. Les mises à jour sont poussées par le
                 téléphone (PhoneDataListenerService -> requestUpdateAll) ; le rappel périodique
                 ne sert que de filet de sécurité, et à 60 s il réveillait la montre chaque minute,
                 jour et nuit, pour relire l'item Data Layer et recomposer l'image. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="600" />
        </service>

    </application>
</manifest>
